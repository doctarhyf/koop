{
  "expo": {
    "name": "koop",
    "slug": "koop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "This app uses the camera to take item pictures.",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to add item pictures.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/koop.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#2F80ED"
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doctarhyf.koop"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.doctarhyf.koop"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "98988ec2-2213-4d5b-973d-21aac371ed88"
      }
    }
  }
}
